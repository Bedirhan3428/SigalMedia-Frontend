{
  "name": "SigalMedia",
  "short_name": "SigalMedia",
  "description": "Yeni nesil modern, hızlı ve bağlantıda tutan sosyal medya platformu.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "portrait-primary",
  "dir": "ltr",
  "lang": "tr-TR",
  "prefer_related_applications": false,
  "categories": [
    "social",
    "entertainment",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/icons/MainLogo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/MainLogo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icons/MainLogo.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/MainLogo.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Akış",
      "short_name": "Akış",
      "description": "Ana sayfa akışını görüntüleyin",
      "url": "/",
      "icons": [
        {
          "src": "/icons/MainLogo.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Keşfet",
      "short_name": "Keşfet",
      "description": "Popüler ve yeni paylaşımları keşfedin",
      "url": "/explore",
      "icons": [
        {
          "src": "/icons/MainLogo.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Profilim",
      "short_name": "Profil",
      "description": "Kendi profilinizi ve gönderilerinizi inceleyin",
      "url": "/profile",
      "icons": [
        {
          "src": "/icons/MainLogo.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*"]
        }
      ]
    }
  }
}
